rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: only owner can read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Customer orders
    match /orders/{orderId} {
      allow create: if true; // Guest or logged-in users can place orders
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || true;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Customer wishlist & style preferences
    match /user_preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
